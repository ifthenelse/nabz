{
  "name": "infra-inspector",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension (Manifest V3) that surfaces CDN / edge / backend infrastructure headers for the currently inspected page.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
